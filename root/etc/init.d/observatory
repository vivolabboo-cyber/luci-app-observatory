#!/bin/sh /etc/rc.common
START=98
STOP=12
USE_PROCD=1
start_service() {
    mkdir -p /tmp/observatory
    chmod 700 /tmp/observatory
    touch /tmp/observatory/dns.log
    chmod 600 /tmp/observatory/dns.log
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/observatory/collector.py
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0"
    procd_close_instance
}
stop_service() {
    nft delete table inet observatory 2>/dev/null || true
}
service_triggers() {
    procd_add_reload_trigger observatory
}
