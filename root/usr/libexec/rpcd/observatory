#!/usr/bin/python3
"""Read-only rpcd interface. Auth and ACL enforcement remain with LuCI/rpcd."""
import json
import os
import pathlib
import re
import sqlite3
import sys
import time
sys.path.insert(0,"/usr/lib/observatory")
from analytics import report as build_report
from diagnostics import report as diagnostic_report

def main():
    if len(sys.argv)>1 and sys.argv[1]=='list':
        print(json.dumps({'snapshot':{},'report':{'hours':32,'device':'','query':{}},'diagnostics':{'device':''}}));return
    if len(sys.argv)<3 or sys.argv[1]!='call':sys.exit(1)
    method=sys.argv[2]
    if method not in ('snapshot','report','diagnostics'):sys.exit(1)
    try:
        config=json.loads(pathlib.Path('/etc/observatory/config.json').read_text())
        args=json.loads(sys.stdin.read(8192) or '{}')
        if not isinstance(args,dict):raise ValueError('Invalid request')
        if method=='diagnostics':
            print(json.dumps(diagnostic_report(config,args),ensure_ascii=False,separators=(',',':')));return
        if method=='snapshot':
            path=pathlib.Path(config['runtime'])/'snapshot.json'
            if not path.exists():print(json.dumps({'error':'Сборщик запускается или остановлен'}));return
            data=json.loads(path.read_text())
            data['stale']=time.time()-data.get('time',0)>30
            print(json.dumps(data,ensure_ascii=False,separators=(',',':')));return
        dbpath=(pathlib.Path(config['store'])/'history.sqlite').resolve()
        db=sqlite3.connect(dbpath.as_uri()+'?mode=ro',uri=True,timeout=3)
        db.execute('PRAGMA query_only=ON')
        data=build_report(db,config,args)
        print(json.dumps(data,ensure_ascii=False,separators=(',',':')))
        db.close()
    except (ValueError,TypeError,KeyError,sqlite3.Error,OSError) as exc:
        print(json.dumps({'error':str(exc)[:180]},ensure_ascii=False))

if __name__=='__main__':main()
